<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <EnableSecurityDebugging>false</EnableSecurityDebugging>
    <PublishUrlHistory>publish\</PublishUrlHistory>
    <InstallUrlHistory />
    <SupportUrlHistory />
    <UpdateUrlHistory />
    <BootstrapperUrlHistory />
    <ErrorReportUrlHistory />
    <FallbackCulture>zh-CN</FallbackCulture>
    <VerifyUploadedFiles>false</VerifyUploadedFiles>
  </PropertyGroup>
  <ItemGroup>
    <Compile Update="Form\Help\AboutForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Form\Help\FunctionDescriptionForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Form\Help\ProjectInfoForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Form\Help\VersionInfoForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Form\FolderManagerCode\FolderManagerForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Form\Main\ToolMain.cs">
      <SubType>Form</SubType>
    </Compile>
  </ItemGroup>
</Project>