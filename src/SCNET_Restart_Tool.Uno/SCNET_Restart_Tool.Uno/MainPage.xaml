<Page x:Class="SCNET_Restart_Tool.Uno.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:SCNET_Restart_Tool.Uno"
      xmlns:models="using:SCNET_Restart_Tool"
      Background="#F5F7FA">

  <Page.Resources>
    <!-- 配色 -->
    <SolidColorBrush x:Key="ColorStart" Color="#2ECC71" />
    <SolidColorBrush x:Key="ColorStop" Color="#E74C3C" />
    <SolidColorBrush x:Key="ColorRestart" Color="#F1C40F" />
    <SolidColorBrush x:Key="ColorManage" Color="#3498DB" />
    <SolidColorBrush x:Key="ColorMonitor" Color="#9B59B6" />
    <SolidColorBrush x:Key="ColorBorder" Color="#DEE2E6" />

    <!-- 服务器列表 ItemTemplate -->
    <DataTemplate x:Key="ServerItemTemplate" x:DataType="models:ServerConfig">
      <Border Padding="12,8" Margin="0,2"
              BorderThickness="0,0,0,1" BorderBrush="#EEEEEE"
              Background="White">
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="1.2*" />
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="0.9*" />
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Column="0" Text="{x:Bind Id}" Foreground="#999" Width="36"
                     VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="{x:Bind Name}" FontWeight="Bold" Foreground="#333" />
            <TextBlock Text="{x:Bind ExeName}" FontSize="11" Foreground="#999"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="#666"
                     Text="{x:Bind DisplayIpPort}" />
          <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="#888" FontSize="12"
                     Text="{x:Bind ExePath}" TextTrimming="CharacterEllipsis" />
          <Border Grid.Column="4" VerticalAlignment="Center" CornerRadius="10"
                  Background="{x:Bind StatusBrush}" Padding="8,3">
            <TextBlock Text="{x:Bind StatusText}" Foreground="White" FontSize="12"
                       HorizontalAlignment="Center" />
          </Border>
        </Grid>
      </Border>
    </DataTemplate>
  </Page.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 顶部标题栏 -->
    <Grid Grid.Row="0" Background="White" Padding="16,10"
          BorderThickness="0,0,0,1" BorderBrush="#E5E7EB">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Text="SCNET服务端管理工具" FontSize="18" FontWeight="Bold"
                   Foreground="#2C3E50" VerticalAlignment="Center" />
        <TextBlock Text="Uno Platform 版" FontSize="12" Foreground="#95A5A6"
                   VerticalAlignment="Center" />
      </StackPanel>
      <Button x:Name="helpBtn" Grid.Column="1" Content="帮助"
              Background="{StaticResource ColorManage}" Foreground="White"
              CornerRadius="6" Padding="18,6"
              Click="HelpBtn_Click" />
    </Grid>

    <!-- 主内容区 -->
    <Grid Grid.Row="1" Padding="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2.2*" />
        <ColumnDefinition Width="1*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- 左侧：服务器列表 + 操作按钮 -->
      <Grid Grid.Column="0" Margin="0,0,10,0" RowSpacing="8">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 服务器列表 -->
        <Grid Grid.Row="0" Background="White" Padding="12,8"
              BorderThickness="0,0,0,1" BorderBrush="#E5E7EB">
          <TextBlock Text="服务器列表" FontWeight="Bold" Foreground="#2C3E50" />
        </Grid>
        <ListView x:Name="serversListView" Grid.Row="1"
                  ItemsSource="{x:Bind ServerItems}"
                  SelectionMode="Single"
                  IsItemClickEnabled="True"
                  ItemTemplate="{StaticResource ServerItemTemplate}"
                  ItemClick="ServersListView_ItemClick"
                  SelectionChanged="ServersListView_SelectionChanged"
                  Background="White" BorderThickness="1" BorderBrush="#E5E7EB" />

        <!-- 管理 / 运行控制 / 监控控制 -->
        <Grid Grid.Row="2" ColumnSpacing="8" Background="White" Padding="10,8"
              BorderThickness="1" BorderBrush="#E5E7EB">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <!-- 服务器管理 -->
          <StackPanel Grid.Column="0" Spacing="6">
            <TextBlock Text="服务器管理" FontWeight="Bold" FontSize="12" Foreground="#3498DB" />
            <Grid ColumnSpacing="6" RowSpacing="6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Button x:Name="addBtn" Grid.Row="0" Grid.Column="0" Content="增加"
                      Background="{StaticResource ColorManage}" Foreground="White"
                      CornerRadius="4" Padding="0,8" Click="AddBtn_Click" />
              <Button x:Name="editBtn" Grid.Row="0" Grid.Column="1" Content="修改"
                      Background="{StaticResource ColorManage}" Foreground="White"
                      CornerRadius="4" Padding="0,8" IsEnabled="False" Click="EditBtn_Click" />
              <Button x:Name="deleteBtn" Grid.Row="1" Grid.Column="0" Content="删除"
                      Background="{StaticResource ColorStop}" Foreground="White"
                      CornerRadius="4" Padding="0,8" IsEnabled="False" Click="DeleteBtn_Click" />
              <Button x:Name="folderManagerBtn" Grid.Row="1" Grid.Column="1" Content="文件夹"
                      Background="{StaticResource ColorManage}" Foreground="White"
                      CornerRadius="4" Padding="0,8" IsEnabled="False" Click="FolderManagerBtn_Click" />
            </Grid>
          </StackPanel>

          <!-- 运行控制 -->
          <StackPanel Grid.Column="1" Spacing="6">
            <TextBlock Text="运行控制" FontWeight="Bold" FontSize="12" Foreground="#3498DB" />
            <Grid ColumnSpacing="6" RowSpacing="6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Button x:Name="startBtn" Grid.Row="0" Grid.Column="0" Content="启动"
                      Background="{StaticResource ColorStart}" Foreground="White"
                      CornerRadius="4" Padding="0,8" IsEnabled="False" Click="StartBtn_Click" />
              <Button x:Name="stopBtn" Grid.Row="0" Grid.Column="1" Content="停止"
                      Background="{StaticResource ColorStop}" Foreground="White"
                      CornerRadius="4" Padding="0,8" IsEnabled="False" Click="StopBtn_Click" />
              <Button x:Name="restartBtn" Grid.Row="1" Grid.Column="0" Content="重启"
                      Background="{StaticResource ColorRestart}" Foreground="White"
                      CornerRadius="4" Padding="0,8" IsEnabled="False" Click="RestartBtn_Click" />
              <Button x:Name="stopAllBtn" Grid.Row="1" Grid.Column="1" Content="停止全部"
                      Background="{StaticResource ColorStop}" Foreground="White"
                      CornerRadius="4" Padding="0,8" IsEnabled="False" Click="StopAllBtn_Click" />
            </Grid>
          </StackPanel>

          <!-- 监控控制 -->
          <StackPanel Grid.Column="2" Spacing="6">
            <TextBlock Text="监控控制" FontWeight="Bold" FontSize="12" Foreground="#3498DB" />
            <Grid ColumnSpacing="6" RowSpacing="6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Button x:Name="startMonitorBtn" Grid.Row="0" Grid.Column="0" Content="开启监控"
                      Background="{StaticResource ColorMonitor}" Foreground="White"
                      CornerRadius="4" Padding="0,8" IsEnabled="False" Click="StartMonitorBtn_Click" />
              <Button x:Name="stopMonitorBtn" Grid.Row="0" Grid.Column="1" Content="关闭监控"
                      Background="{StaticResource ColorMonitor}" Foreground="White"
                      CornerRadius="4" Padding="0,8" IsEnabled="False" Click="StopMonitorBtn_Click" />
              <Button x:Name="sendCommandBtn" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Content="发送指令"
                      Background="{StaticResource ColorManage}" Foreground="White"
                      CornerRadius="4" Padding="0,8" IsEnabled="False" Click="SendCommandBtn_Click" />
            </Grid>
          </StackPanel>
        </Grid>

        <!-- 指令输入 -->
        <Grid Grid.Row="3" ColumnSpacing="8" Background="White" Padding="10,8"
              BorderThickness="1" BorderBrush="#E5E7EB">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="指令：" VerticalAlignment="Center" Foreground="#666" />
          <TextBox x:Name="commandInput" Grid.Column="1" Text="say 服务器即将重启"
                   CornerRadius="4" PlaceholderText="输入要发送的指令" />
        </Grid>
      </Grid>

      <!-- 右侧：编辑面板 -->
      <Border Grid.Column="1" Background="White" BorderThickness="1" BorderBrush="#E5E7EB" Padding="14">
        <StackPanel Spacing="10">
          <TextBlock Text="服务器配置" FontWeight="Bold" Foreground="#2C3E50" FontSize="15" />

          <TextBlock Text="服务器名：" Foreground="#555" />
          <TextBox x:Name="serverNameInput" CornerRadius="4" IsEnabled="False" />

          <TextBlock Text="程序路径：" Foreground="#555" />
          <Grid ColumnSpacing="6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="exePathInput" CornerRadius="4" IsEnabled="False" />
            <Button x:Name="browseExeBtn" Grid.Column="1" Content="浏览"
                    Background="{StaticResource ColorManage}" Foreground="White"
                    CornerRadius="4" Padding="14,6" IsEnabled="False" Click="BrowseExeBtn_Click" />
          </Grid>

          <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="4">
              <TextBlock Text="IP：" Foreground="#555" />
              <TextBox x:Name="ipInput" Text="127.0.0.1" CornerRadius="4" IsEnabled="False" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock Text="端口：" Foreground="#555" />
              <TextBox x:Name="portInput" Text="5612" CornerRadius="4" IsEnabled="False" />
            </StackPanel>
          </Grid>

          <TextBlock Text="密码（可选）：" Foreground="#555" />
          <PasswordBox x:Name="passwordInput" CornerRadius="4" IsEnabled="False" />

          <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="4">
              <TextBlock Text="定时重启（HH:mm）：" Foreground="#555" />
              <TextBox x:Name="scheduleTimeInput" Text="01:00" CornerRadius="4" IsEnabled="False" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock Text="间隔小时（0=关闭）：" Foreground="#555" />
              <TextBox x:Name="intervalHoursInput" Text="0" CornerRadius="4" IsEnabled="False" />
            </StackPanel>
          </Grid>

          <CheckBox x:Name="enableCommandsChk" Content="启用指令功能" IsEnabled="False" />

          <Grid ColumnSpacing="8" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="saveEditBtn" Grid.Column="0" Content="保存配置"
                    Background="{StaticResource ColorStart}" Foreground="White"
                    CornerRadius="4" Padding="0,8" IsEnabled="False" Click="SaveEditBtn_Click" />
            <Button x:Name="cancelEditBtn" Grid.Column="1" Content="取消编辑"
                    Background="{StaticResource ColorStop}" Foreground="White"
                    CornerRadius="4" Padding="0,8" IsEnabled="False" Click="CancelEditBtn_Click" />
          </Grid>

          <TextBlock x:Name="statusHintText" FontSize="12" Foreground="#999"
                     Text="提示：选择服务器后可进行编辑与操作" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- 底部：日志区 -->
    <Grid Grid.Row="2" Background="White" Padding="10,8"
          BorderThickness="0,1,0,0" BorderBrush="#E5E7EB">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="运行日志" FontWeight="Bold" Foreground="#2C3E50" />
        <Button x:Name="clearLogBtn" Grid.Column="1" Content="清空日志"
                Background="{StaticResource ColorStop}" Foreground="White"
                CornerRadius="4" Padding="14,4" Click="ClearLogBtn_Click" />
      </Grid>
      <TextBox x:Name="logTextBox" Grid.Row="1" Height="120" Margin="0,6,0,0"
               IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
               FontFamily="Consolas" FontSize="12" Foreground="#333"
               Background="#FAFBFC" BorderBrush="#E5E7EB" CornerRadius="4" />
    </Grid>
  </Grid>
</Page>
