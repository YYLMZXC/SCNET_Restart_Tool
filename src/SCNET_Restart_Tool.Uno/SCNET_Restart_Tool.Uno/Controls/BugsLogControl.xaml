<UserControl x:Class="SCNET_Restart_Tool.Uno.Controls.BugsLogControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:SCNET_Restart_Tool.Uno.Controls">

  <Grid Padding="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 路径显示 -->
    <Border Grid.Row="0" Background="#F5F5F5" Padding="8,6" Margin="0,0,0,6"
            CornerRadius="4" BorderBrush="#E0E0E0" BorderThickness="1">
      <Grid ColumnSpacing="6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="路径：" VerticalAlignment="Center" Foreground="#666" />
        <TextBlock x:Name="pathText" Grid.Column="1" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" Foreground="#333" />
      </Grid>
    </Border>

    <!-- 日志预览 + 文件列表（左右分栏） -->
    <Grid Grid.Row="1" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" />
        <ColumnDefinition Width="1.2*" />
      </Grid.ColumnDefinitions>

      <!-- 左侧：Game.log 预览 -->
      <Border Grid.Column="0" BorderBrush="#E5E7EB" BorderThickness="1" Background="White" CornerRadius="4">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBox x:Name="logPreview" Grid.Row="0" IsReadOnly="True"
                   AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas"
                   FontSize="12" Background="#FAFBFC" BorderThickness="0" Margin="6" />
          <Grid Grid.Row="1" Padding="6" Background="#F5F5F5">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="btnPrev" Content="上一页" Click="BtnPrev_Click"
                    Background="#2980B9" Foreground="White" CornerRadius="4" Padding="12,4" />
            <TextBlock x:Name="pageLabel" Grid.Column="1" Text="未加载日志"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#666" />
            <Button x:Name="btnNext" Grid.Column="2" Content="下一页" Click="BtnNext_Click"
                    Background="#2980B9" Foreground="White" CornerRadius="4" Padding="12,4" />
          </Grid>
        </Grid>
      </Border>

      <!-- 右侧：其他文件列表 -->
      <Border Grid.Column="1" BorderBrush="#E5E7EB" BorderThickness="1" Background="White" CornerRadius="4">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Text="Bugs 目录文件" FontWeight="Bold" Foreground="#555" Padding="8,6" />
          <ListView x:Name="fileListView" Grid.Row="1" SelectionMode="Single"
                    Background="White" BorderThickness="0">
            <ListView.ItemTemplate>
              <DataTemplate>
                <Grid Padding="6,5" ColumnSpacing="6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="120" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Name}" Foreground="#333" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Text="{Binding Size}" Foreground="#666" />
                  <TextBlock Grid.Column="2" Text="{Binding LastWriteTime}" Foreground="#888" />
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </Grid>
      </Border>
    </Grid>

    <!-- 操作按钮 -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
      <Button x:Name="btnRefresh" Content="刷新" Click="BtnRefresh_Click"
              Background="#3498DB" Foreground="White" CornerRadius="4" Padding="14,6" />
      <Button x:Name="btnOpen" Content="打开目录" Click="BtnOpen_Click"
              Background="#2980B9" Foreground="White" CornerRadius="4" Padding="14,6" />
      <Button x:Name="btnDelete" Content="删除选中" Click="BtnDelete_Click"
              Background="#E74C3C" Foreground="White" CornerRadius="4" Padding="14,6" />
      <Button x:Name="btnClean" Content="清理过期日志" Click="BtnClean_Click"
              Background="#F1C40F" Foreground="White" CornerRadius="4" Padding="14,6" />
      <Button x:Name="btnBatchBackup" Content="批量备份所有目录" Click="BtnBatchBackup_Click"
              Background="#3498DB" Foreground="White" CornerRadius="4" Padding="14,6" />
    </StackPanel>
  </Grid>
</UserControl>
