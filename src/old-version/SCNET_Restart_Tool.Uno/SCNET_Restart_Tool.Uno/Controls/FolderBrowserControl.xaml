<UserControl x:Class="SCNET_Restart_Tool.Uno.Controls.FolderBrowserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:SCNET_Restart_Tool.Uno.Controls">

  <Grid Padding="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 路径显示 -->
    <Border Grid.Row="0" Background="#F5F5F5" Padding="8,6" Margin="0,0,0,6"
            CornerRadius="4" BorderBrush="#E0E0E0" BorderThickness="1">
      <Grid ColumnSpacing="6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="路径：" VerticalAlignment="Center" Foreground="#666" />
        <TextBlock x:Name="pathText" Grid.Column="1" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" Foreground="#333" />
      </Grid>
    </Border>

    <!-- 文件/文件夹列表 -->
    <ListView x:Name="fileListView" Grid.Row="1"
              SelectionMode="Single"
              IsItemClickEnabled="True"
              ItemClick="FileListView_ItemClick"
              Background="White" BorderThickness="1" BorderBrush="#E5E7EB">
      <ListView.Header>
        <Grid Padding="8,6" Background="#F8F9FA" ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="70" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="90" />
            <ColumnDefinition Width="150" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="类型" FontWeight="Bold" Foreground="#555" />
          <TextBlock Grid.Column="1" Text="名称" FontWeight="Bold" Foreground="#555" />
          <TextBlock Grid.Column="2" Text="大小(KB)" FontWeight="Bold" Foreground="#555" />
          <TextBlock Grid.Column="3" Text="修改时间" FontWeight="Bold" Foreground="#555" />
        </Grid>
      </ListView.Header>
      <ListView.ItemTemplate>
        <DataTemplate>
          <Grid Padding="8,6" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="70" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="90" />
              <ColumnDefinition Width="150" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Type}" Foreground="#3498DB" FontWeight="Bold" />
            <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#333" />
            <TextBlock Grid.Column="2" Text="{Binding Size}" Foreground="#666" />
            <TextBlock Grid.Column="3" Text="{Binding LastWriteTime}" Foreground="#888" />
          </Grid>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>

    <!-- 操作按钮 -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
      <Button x:Name="btnRefresh" Content="刷新" Click="BtnRefresh_Click"
              Background="#3498DB" Foreground="White" CornerRadius="4" Padding="14,6" />
      <Button x:Name="btnBack" Content="返回上级" Click="BtnBack_Click"
              Background="#2980B9" Foreground="White" CornerRadius="4" Padding="14,6" />
      <Button x:Name="btnOpen" Content="打开目录" Click="BtnOpen_Click"
              Background="#2980B9" Foreground="White" CornerRadius="4" Padding="14,6" />
      <Button x:Name="btnAdd" Content="添加文件" Click="BtnAdd_Click"
              Background="#2ECC71" Foreground="White" CornerRadius="4" Padding="14,6" />
      <Button x:Name="btnDelete" Content="删除选中" Click="BtnDelete_Click"
              Background="#E74C3C" Foreground="White" CornerRadius="4" Padding="14,6" />
    </StackPanel>
  </Grid>
</UserControl>
