<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SCNET_Restart_Tool.Avalonia.Controls.BugsLogControl">

  <Grid RowDefinitions="Auto,*,Auto" Margin="8">

    <!-- 路径显示 -->
    <Border Grid.Row="0" Background="#F5F6F8" Padding="8,6" Margin="0,0,0,6"
            CornerRadius="6" BorderBrush="#E0E4E8" BorderThickness="1">
      <Grid ColumnDefinitions="Auto,*">
        <TextBlock Text="路径：" VerticalAlignment="Center" Foreground="#5A6672" />
        <TextBlock x:Name="pathText" Grid.Column="1" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" Foreground="#2C3E50" />
      </Grid>
    </Border>

    <!-- 日志预览 + 文件列表（左右分栏） -->
    <Grid Grid.Row="1" ColumnDefinitions="2*,1.2*">

      <!-- 左侧：Game.log 分页预览 -->
      <Border Grid.Column="0" Margin="0,0,4,0" Background="White"
              BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6">
        <Grid RowDefinitions="*,Auto">
          <TextBox x:Name="logPreview" Grid.Row="0" IsReadOnly="True"
                   AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas, Microsoft YaHei UI"
                   FontSize="12" Background="#FAFBFC" BorderThickness="0" Margin="6"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   ScrollViewer.HorizontalScrollBarVisibility="Auto" />
          <Border Grid.Row="1" Background="#F5F6F8" Padding="6"
                  BorderBrush="#E5E7EB" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Button x:Name="btnPrev" Content="上一页" Click="BtnPrev_Click"
                      Theme="{StaticResource ColorButton}" Background="#2980B9" Padding="12,4"
                      FontSize="12" />
              <TextBlock x:Name="pageLabel" Grid.Column="1" Text="未加载日志"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Foreground="#66707A" FontSize="12" />
              <Button x:Name="btnNext" Grid.Column="2" Content="下一页" Click="BtnNext_Click"
                      Theme="{StaticResource ColorButton}" Background="#2980B9" Padding="12,4"
                      FontSize="12" />
            </Grid>
          </Border>
        </Grid>
      </Border>

      <!-- 右侧：其他日志文件列表 -->
      <Border Grid.Column="1" Margin="4,0,0,0" Background="White"
              BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Text="Bugs 目录文件" FontWeight="Bold" Foreground="#5A6672" FontSize="12"
                     Margin="8,7" />
          <ListBox x:Name="fileListBox" Grid.Row="1" Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="*,70,110" Height="24">
                  <TextBlock Text="{Binding Name}" Foreground="#2C3E50" FontSize="12"
                             TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding Size}" Foreground="#66707A"
                             FontSize="12" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding LastWriteTime}" Foreground="#8A939B"
                             FontSize="12" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
    </Grid>

    <!-- 操作按钮 -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
      <Button x:Name="btnRefresh" Content="刷新" Click="BtnRefresh_Click"
              Theme="{StaticResource ColorButton}" Background="#3498DB" Padding="16,6" />
      <Button x:Name="btnOpen" Content="打开目录" Click="BtnOpen_Click"
              Theme="{StaticResource ColorButton}" Background="#2980B9" Padding="16,6" />
      <Button x:Name="btnDelete" Content="删除选中" Click="BtnDelete_Click"
              Theme="{StaticResource ColorButton}" Background="#E74C3C" Padding="16,6" />
      <Button x:Name="btnClean" Content="清理过期日志" Click="BtnClean_Click"
              Theme="{StaticResource ColorButton}" Background="#F1C40F" Padding="16,6" />
      <Button x:Name="btnBatchBackup" Content="批量备份所有目录" Click="BtnBatchBackup_Click"
              Theme="{StaticResource ColorButton}" Background="#3498DB" Padding="16,6" />
    </StackPanel>
  </Grid>
</UserControl>
