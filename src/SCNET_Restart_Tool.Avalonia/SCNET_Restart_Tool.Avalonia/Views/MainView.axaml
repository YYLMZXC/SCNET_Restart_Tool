<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SCNET_Restart_Tool.Avalonia.Views.MainView">

  <UserControl.Styles>
    <!-- 表单标签 -->
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="#5A6672" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <!-- 分组标题 -->
    <Style Selector="TextBlock.groupTitle">
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#3498DB" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <!-- 卡片容器 -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#E5E7EB" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto" Background="#F5F7FA">

    <!-- ==================== 顶部标题栏 ==================== -->
    <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="16,10">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Text="SCNET服务端管理工具" FontSize="18" FontWeight="Bold"
                     Foreground="#2C3E50" VerticalAlignment="Center" />
          <Border Background="#E8F4FD" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
            <TextBlock Text="Avalonia 版" FontSize="11" Foreground="#3498DB" />
          </Border>
          <!-- 版本号由构建时间自动生成（yy.MM.dd），在代码中填充 -->
          <TextBlock x:Name="versionText" FontSize="11" Foreground="#99A1A8"
                     VerticalAlignment="Center" />
        </StackPanel>
        <Button x:Name="helpBtn" Grid.Column="1" Content="帮助"
                Theme="{StaticResource ColorButton}" Background="#3498DB" Padding="20,6"
                VerticalAlignment="Center" Click="HelpBtn_Click" />
      </Grid>
    </Border>

    <!-- ==================== 主内容区 ==================== -->
    <Grid Grid.Row="1" ColumnDefinitions="2.2*,1*" Margin="10">

      <!-- 左侧：服务器列表 + 操作按钮 + 指令输入 -->
      <Grid Grid.Column="0" RowDefinitions="*,Auto,Auto" Margin="0,0,10,0">

        <!-- 服务器列表 -->
        <Border Grid.Row="0" Classes="card">
          <Grid RowDefinitions="Auto,*">
            <Border Padding="12,9" BorderBrush="#EEF1F4" BorderThickness="0,0,0,1">
              <TextBlock Text="服务器列表" FontWeight="Bold" Foreground="#2C3E50" />
            </Border>
            <ListBox x:Name="serversListBox" Grid.Row="1" Background="Transparent"
                     BorderThickness="0"
                     SelectionChanged="ServersListBox_SelectionChanged">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Padding="12,8" BorderBrush="#F0F2F5" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="Auto,2*,Auto,1.2*,2*,Auto">
                      <TextBlock Grid.Column="0" Text="{Binding Id}" Foreground="#99A1A8"
                                 Width="34" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#2C3E50"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding DisplaySubtitle}" FontSize="11" Foreground="#99A1A8"
                                   TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <Border Grid.Column="2" Background="{Binding ModeBrush}" CornerRadius="10"
                              Padding="8,3" VerticalAlignment="Center" Margin="6,0,6,0">
                        <TextBlock Text="{Binding ModeText}" Foreground="White" FontSize="12"
                                   HorizontalAlignment="Center" />
                      </Border>
                      <TextBlock Grid.Column="3" Text="{Binding DisplayIpPort}" Foreground="#66707A"
                                 VerticalAlignment="Center" Margin="6,0,0,0" />
                      <TextBlock Grid.Column="4" Text="{Binding DisplayPath}" Foreground="#8A939B"
                                 FontSize="12" TextTrimming="CharacterEllipsis"
                                 VerticalAlignment="Center" Margin="6,0,6,0" />
                      <Border Grid.Column="5" Background="{Binding StatusBrush}" CornerRadius="10"
                              Padding="8,3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="12"
                                   HorizontalAlignment="Center" />
                      </Border>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>

        <!-- 管理 / 运行控制 / 监控控制 -->
        <Border Grid.Row="1" Classes="card" Padding="10,9" Margin="0,8,0,0">
          <Grid ColumnDefinitions="*,*,*">
            <!-- 服务器管理 -->
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
              <TextBlock Classes="groupTitle" Text="服务器管理" />
              <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Margin="-3">
                <Button x:Name="addBtn" Grid.Row="0" Grid.Column="0" Content="增加" Margin="3"
                        Theme="{StaticResource ColorButton}" Background="#3498DB" IsEnabled="False"
                        Click="AddBtn_Click" />
                <Button x:Name="editBtn" Grid.Row="0" Grid.Column="1" Content="修改" Margin="3"
                        Theme="{StaticResource ColorButton}" Background="#3498DB" IsEnabled="False"
                        Click="EditBtn_Click" />
                <Button x:Name="deleteBtn" Grid.Row="1" Grid.Column="0" Content="删除" Margin="3"
                        Theme="{StaticResource ColorButton}" Background="#E74C3C" IsEnabled="False"
                        Click="DeleteBtn_Click" />
                <Button x:Name="folderManagerBtn" Grid.Row="1" Grid.Column="1" Content="文件夹" Margin="3"
                        Theme="{StaticResource ColorButton}" Background="#3498DB" IsEnabled="False"
                        Click="FolderManagerBtn_Click" />
              </Grid>
            </StackPanel>

            <!-- 运行控制 -->
            <StackPanel Grid.Column="1" Margin="0,0,10,0">
              <TextBlock Classes="groupTitle" Text="运行控制" />
              <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Margin="-3">
                <Button x:Name="startBtn" Grid.Row="0" Grid.Column="0" Content="启动" Margin="3"
                        Theme="{StaticResource ColorButton}" Background="#2ECC71" IsEnabled="False"
                        Click="StartBtn_Click" />
                <Button x:Name="stopBtn" Grid.Row="0" Grid.Column="1" Content="停止" Margin="3"
                        Theme="{StaticResource ColorButton}" Background="#E74C3C" IsEnabled="False"
                        Click="StopBtn_Click" />
                <Button x:Name="restartBtn" Grid.Row="1" Grid.Column="0" Content="重启" Margin="3"
                        Theme="{StaticResource ColorButton}" Background="#F1C40F" IsEnabled="False"
                        Click="RestartBtn_Click" />
                <Button x:Name="stopAllBtn" Grid.Row="1" Grid.Column="1" Content="停止全部" Margin="3"
                        Theme="{StaticResource ColorButton}" Background="#E74C3C" IsEnabled="False"
                        Click="StopAllBtn_Click" />
              </Grid>
            </StackPanel>

            <!-- 监控控制 -->
            <StackPanel Grid.Column="2">
              <TextBlock Classes="groupTitle" Text="监控控制" />
              <Grid ColumnDefinitions="*,*" Margin="-3">
                <Button x:Name="startMonitorBtn" Grid.Column="0" Content="开启监控" Margin="3"
                        Theme="{StaticResource ColorButton}" Background="#9B59B6" IsEnabled="False"
                        FontSize="12" Click="StartMonitorBtn_Click" />
                <Button x:Name="stopMonitorBtn" Grid.Column="1" Content="关闭监控" Margin="3"
                        Theme="{StaticResource ColorButton}" Background="#9B59B6" IsEnabled="False"
                        FontSize="12" Click="StopMonitorBtn_Click" />
              </Grid>
            </StackPanel>
          </Grid>
        </Border>

        <!-- 指令输入：常用指令下拉快捷选择 + 手动输入 + 发送（回车等效） -->
        <Border Grid.Row="2" Classes="card" Padding="10,9" Margin="0,8,0,0">
          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Text="常用指令：" Foreground="#5A6672" VerticalAlignment="Center" Margin="0,0,6,0" />
              <ComboBox x:Name="quickCommandBox" Grid.Column="1" IsEnabled="False"
                        SelectionChanged="QuickCommandBox_SelectionChanged">
                <ComboBoxItem Content="stop 9 例行维护 —— 延迟 9 秒存档关闭" Tag="stop 9 例行维护" />
                <ComboBoxItem Content="stop now —— 立即关闭服务器" Tag="stop now" />
                <ComboBoxItem Content="list —— 查看在线玩家列表" Tag="list" />
                <ComboBoxItem Content="help —— 查看全部指令帮助" Tag="help" />
                <ComboBoxItem Content="help stop —— 查看指定指令用法（示例）" Tag="help stop" />
                <ComboBoxItem Content="time set day —— 游戏时间设为白天" Tag="time set day" />
                <ComboBoxItem Content="time set night —— 游戏时间设为夜晚" Tag="time set night" />
                <ComboBoxItem Content="gamerule keepInventory true —— 死亡不掉落" Tag="gamerule keepInventory true" />
                <ComboBoxItem Content="admission on —— 开放新玩家准入" Tag="admission on" />
                <ComboBoxItem Content="admission off —— 关闭新玩家准入" Tag="admission off" />
                <ComboBoxItem Content="kick &lt;玩家&gt; —— 踢出玩家（请替换 &lt;玩家&gt;）" Tag="kick &lt;玩家&gt;" />
                <ComboBoxItem Content="ban add &lt;玩家&gt; —— 封禁玩家（请替换 &lt;玩家&gt;）" Tag="ban add &lt;玩家&gt;" />
                <ComboBoxItem Content="op &lt;玩家&gt; —— 授予管理员权限（请替换 &lt;玩家&gt;）" Tag="op &lt;玩家&gt;" />
                <ComboBoxItem Content="give &lt;玩家&gt; &lt;物品id&gt; [数量] —— 给予物品" Tag="give &lt;玩家&gt; &lt;物品id&gt; [数量]" />
                <ComboBoxItem Content="clear animal —— 清理动物实体" Tag="clear animal" />
                <ComboBoxItem Content="tune —— 查看服务器性能参数" Tag="tune" />
              </ComboBox>
            </Grid>
            <Grid ColumnDefinitions="Auto,*,Auto">
              <TextBlock Text="指  令：" Foreground="#5A6672" VerticalAlignment="Center" Margin="0,0,6,0" />
              <TextBox x:Name="commandInput" Grid.Column="1"
                       Watermark="从上方下拉选择或手动输入（可省略前导 /），回车或点「发送」执行"
                       KeyDown="CommandInput_KeyDown" />
              <Button x:Name="sendCommandBtn" Grid.Column="2" Content="发送" Margin="6,0,0,0" MinWidth="72"
                      Theme="{StaticResource ColorButton}" Background="#2ECC71" IsEnabled="False"
                      Click="SendCommandBtn_Click" />
            </Grid>
          </StackPanel>
        </Border>
      </Grid>

      <!-- 右侧：服务器配置编辑面板 -->
      <Border Grid.Column="1" Classes="card" Padding="14">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="8">
            <TextBlock Text="服务器配置" FontWeight="Bold" Foreground="#2C3E50" FontSize="15"
                       Margin="0,0,0,2" />

            <!-- 管理方式：本地（进程/文件）与远程（RCON 网络）单选，切换后按模式显示对应配置项 -->
            <TextBlock Classes="label" Text="管理方式：" Margin="0,2,0,2" />
            <Grid ColumnDefinitions="*,*">
              <RadioButton x:Name="modeLocalRadio" Grid.Column="0" Content="本地管理"
                           IsEnabled="False" GroupName="ManageMode"
                           Checked="ModeRadio_Changed" Unchecked="ModeRadio_Changed" />
              <RadioButton x:Name="modeRemoteRadio" Grid.Column="1" Content="远程管理（RCON）"
                           IsEnabled="False" GroupName="ManageMode"
                           Checked="ModeRadio_Changed" Unchecked="ModeRadio_Changed" />
            </Grid>
            <TextBlock x:Name="modeHintText" FontSize="11" Foreground="#99A1A8" TextWrapping="Wrap"
                       Text="本地：可启动/重启进程、管理文件夹与 ServerSetting.json" />

            <TextBlock Classes="label" Text="服务器名：" Margin="0,4,0,2" />
            <TextBox x:Name="serverNameInput" IsEnabled="False" />

            <StackPanel x:Name="exePathSection">
              <TextBlock Classes="label" Text="程序路径：" Margin="0,4,0,4" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBox x:Name="exePathInput" IsEnabled="False" />
                <Button x:Name="browseExeBtn" Grid.Column="1" Content="浏览" Margin="6,0,0,0"
                        Theme="{StaticResource ColorButton}" Background="#3498DB" IsEnabled="False"
                        Padding="16,6" Click="BrowseExeBtn_Click" />
              </Grid>
            </StackPanel>

            <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
              <StackPanel Grid.Column="0" Margin="0,0,5,0">
                <TextBlock Classes="label" Text="IP：" />
                <TextBox x:Name="ipInput" Text="127.0.0.1" IsEnabled="False" />
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="5,0,0,0">
                <TextBlock Classes="label" Text="RCON 端口：" />
                <TextBox x:Name="portInput" Text="28900" IsEnabled="False" />
              </StackPanel>
            </Grid>

            <TextBlock Classes="label" Text="RCON 口令（启用指令时必填，≥12 字符）：" Margin="0,4,0,4" />
            <TextBox x:Name="passwordInput" PasswordChar="*" IsEnabled="False" />

            <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
              <StackPanel Grid.Column="0" Margin="0,0,5,0">
                <TextBlock Classes="label" Text="定时重启（HH:mm）：" />
                <TextBox x:Name="scheduleTimeInput" Text="01:00" IsEnabled="False" />
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="5,0,0,0">
                <TextBlock Classes="label" Text="间隔小时（0=关闭）：" />
                <TextBox x:Name="intervalHoursInput" Text="0" IsEnabled="False" />
              </StackPanel>
            </Grid>

            <CheckBox x:Name="enableCommandsChk" Content="启用指令功能" IsEnabled="False" Margin="0,6,0,0" />
            <CheckBox x:Name="useTlsChk" Content="加密连接（TLS，服务端自签证书）"
                      IsEnabled="False" Margin="0,4,0,0" IsChecked="True" />

            <!-- 服务端 ServerSetting.json 直读直写：与编辑面板无关，选中服务器即可操作（仅本地模式） -->
            <Border x:Name="serverSettingPanel" Classes="card" Background="#F8FAFC" Padding="10,8" Margin="0,12,0,0">
              <StackPanel Spacing="6">
                <TextBlock Classes="groupTitle" Text="服务端设置（ServerSetting.json）" Margin="0" />
                <Grid ColumnDefinitions="*,*">
                  <StackPanel Grid.Column="0" Margin="0,0,5,0">
                    <TextBlock Classes="label" Text="服务端端口：" Margin="0" />
                    <TextBox x:Name="serverPortInput" Text="28887" IsEnabled="False" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="5,0,0,0">
                    <TextBlock Classes="label" Text="RCON 端口：" Margin="0" />
                    <TextBox x:Name="rconPortInput" Text="28900" IsEnabled="False" />
                  </StackPanel>
                </Grid>
                <Grid ColumnDefinitions="*,*">
                  <StackPanel Grid.Column="0" Margin="0,0,5,0">
                    <TextBlock Classes="label" Text="RCON 监听地址（空=仅本机）：" Margin="0" />
                    <TextBox x:Name="rconBindInput" Text="127.0.0.1" IsEnabled="False" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="5,0,0,0">
                    <TextBlock Classes="label" Text="指令超时（秒，1-120）：" Margin="0" />
                    <TextBox x:Name="rconTimeoutInput" Text="10" IsEnabled="False" />
                  </StackPanel>
                </Grid>
                <Grid ColumnDefinitions="*,*">
                  <CheckBox x:Name="rconEnabledChk" Content="开启 RCON 远程控制" IsChecked="False" IsEnabled="False" />
                  <CheckBox x:Name="rconPlaintextChk" Grid.Column="1" Content="允许明文（关 TLS，仅受信内网）"
                            IsChecked="False" IsEnabled="False" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <TextBlock Classes="label" Text="TLS 证书：" Margin="0,6,5,0" VerticalAlignment="Center" />
                  <TextBox x:Name="rconCertInput" Grid.Column="1" Watermark="留空 = 服务端自签证书" IsEnabled="False" />
                  <Button x:Name="browseCertBtn" Grid.Column="2" Content="…" Margin="4,0,0,0" MinWidth="32"
                          Theme="{StaticResource ColorButton}" Background="#3498DB" IsEnabled="False"
                          Click="BrowseCertBtn_Click" />
                </Grid>
                <Grid ColumnDefinitions="*,*">
                  <Button x:Name="readServerSettingBtn" Grid.Column="0" Content="读取设置" Margin="0,0,4,0"
                          Theme="{StaticResource ColorButton}" Background="#3498DB" IsEnabled="False"
                          Click="ReadServerSettingBtn_Click" />
                  <Button x:Name="applyServerSettingBtn" Grid.Column="1" Content="应用到服务端" Margin="4,0,0,0"
                          Theme="{StaticResource ColorButton}" Background="#2ECC71" IsEnabled="False"
                          Click="ApplyServerSettingBtn_Click" />
                </Grid>
                <TextBlock FontSize="11" Foreground="#99A1A8" TextWrapping="Wrap"
                           Text="修改需重启服务端生效；应用时会同步本工具的连接参数（端口 / 加密 / 地址）；口令（≥12 字符）由本工具启动服务端时自动注入，服务端手动设置过口令则不覆盖" />
              </StackPanel>
            </Border>

            <Grid ColumnDefinitions="*,*" Margin="0,6,0,0">
              <Button x:Name="saveEditBtn" Grid.Column="0" Content="保存配置" Margin="0,0,4,0"
                      Theme="{StaticResource ColorButton}" Background="#2ECC71" IsEnabled="False"
                      Click="SaveEditBtn_Click" />
              <Button x:Name="cancelEditBtn" Grid.Column="1" Content="取消编辑" Margin="4,0,0,0"
                      Theme="{StaticResource ColorButton}" Background="#E74C3C" IsEnabled="False"
                      Click="CancelEditBtn_Click" />
            </Grid>

            <TextBlock x:Name="statusHintText" FontSize="12" Foreground="#99A1A8"
                       TextWrapping="Wrap" Margin="0,2,0,0"
                       Text="提示：选择服务器后可进行编辑与操作" />
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- ==================== 底部：运行日志 ==================== -->
    <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="10,8">
      <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
          <TextBlock Text="运行日志" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Center" />
          <Button x:Name="clearLogBtn" Grid.Column="1" Content="清空日志"
                  Theme="{StaticResource ColorButton}" Background="#E74C3C" Padding="14,5"
                  FontSize="12" Click="ClearLogBtn_Click" />
        </Grid>
        <TextBox x:Name="logTextBox" Grid.Row="1" Height="130"
                 IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                 FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" Foreground="#3C4650"
                 Background="#FAFBFC" BorderBrush="#E5E7EB"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
